{
  "manifest_version": 3,
  "name": "Abhyashify study timer",
  "version": "1.0.0",
  "description": "Counts the time you spend on the study websites you choose and hands the totals to Abhyashify. Nothing leaves your computer.",
  "permissions": ["storage", "tabs", "idle", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Abhyashify study timer", "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://aditya454760.github.io/Abhyashify/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
